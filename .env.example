# ─── MySQL (CPC app database) ───
MYSQL_ROOT_PASSWORD=cpc_root_dev
MYSQL_DATABASE=cpc
MYSQL_USER=cpc
MYSQL_PASSWORD=cpc_dev_pw
DATABASE_URL=mysql+pymysql://cpc:cpc_dev_pw@mysql:3306/cpc

# ─── Postgres (Zitadel's own backing store — Zitadel does not support MySQL) ───
ZITADEL_DB_PASSWORD=zitadel_dev_pw

# ─── Zitadel ───
# Generate with: openssl rand -base64 24   (must be exactly 32 characters —
# `-base64 32` produces a 44-char string and Zitadel will reject it)
ZITADEL_MASTERKEY=CHANGE_ME_32_BYTE_BASE64_MASTERKEY
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=Admin1234!
ZITADEL_ADMIN_EMAIL=admin@cpc.local
ZITADEL_ISSUER=http://localhost:8080
# For devices on your LAN, set this to the computer's LAN IP or DNS name.
ZITADEL_EXTERNAL_DOMAIN=localhost
# Extra trusted issuers for the backend's token check (comma-separated), beyond
# ZITADEL_ISSUER above. Leave blank unless you're running the Cloudflare customer-testing
# setup — see docs/cloudflare-customer-testing.md.
ZITADEL_ADDITIONAL_ISSUERS=

# Filled in by scripts/bootstrap_zitadel.py after first run
ZITADEL_CLIENT_ID=

# SMTP so Zitadel can send registration/activation/password-reset emails.
# Only takes effect on a brand-new instance init via docker-compose env vars —
# for an already-running instance, activate it via Console instead (see README).
ZITADEL_SMTP_HOST=smtp.gmail.com
ZITADEL_SMTP_PORT=587
ZITADEL_SMTP_USER=
ZITADEL_SMTP_PASSWORD=
ZITADEL_SMTP_FROM=
ZITADEL_SMTP_FROM_NAME=CPC — Critical Power Command

# ─── Backend ───
CORS_ORIGINS=http://localhost:5173
SEED_ON_START=true
SUPERADMIN_ZITADEL_SUB=
SUPERADMIN_EMAIL=admin@cpc.local

# MQTT telemetry source. Store only the device base topic in the ATS/generator form;
# the backend maps its /POWER and /STATUS children into InfluxDB fields.
MQTT_ENABLED=false
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_FILTER=#
MQTT_TLS=false

# InfluxDB 2.x time-series storage
INFLUXDB_USERNAME=cpc
INFLUXDB_PASSWORD=cpc-development-password
INFLUXDB_TOKEN=cpc-development-token-change-me
INFLUXDB_ORG=cpc
INFLUXDB_BUCKET=telemetry

# ─── Frontend (Vite) ───
VITE_API_BASE=http://localhost:8000
VITE_ZITADEL_AUTHORITY=http://localhost:8080
VITE_ZITADEL_CLIENT_ID=
VITE_GRAFANA_URL=http://localhost:3000
