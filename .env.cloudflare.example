# Customer-testing frontend env (docker-compose.cloudflare.yml, served on host port 5174).
# Copy this file to .env.cloudflare and fill in your current Cloudflare Tunnel URLs.
# See docs/cloudflare-customer-testing.md for the full setup.
#
# A named Cloudflare Tunnel (cloudflared running as a service, routes managed in the
# Cloudflare dashboard) gives stable hostnames that don't change on restart, unlike a
# Quick Tunnel (`cloudflared tunnel --url ...`), which gets a brand-new random hostname
# every time it restarts. Example below uses a named tunnel: empm-test.mepstrait.in ->
# localhost:5174, auth-test.mepstrait.in -> localhost:8080.

# Public URL of the backend tunnel route (-> http://localhost:8000).
VITE_API_BASE=https://your-backend-tunnel.example.com

# Public URL of the Zitadel tunnel route (-> http://localhost:8080).
VITE_ZITADEL_AUTHORITY=https://auth-test.mepstrait.in

# Same OIDC client as local dev — Zitadel clients accept multiple registered redirect
# URIs, so this one client can serve both http://localhost:5173/callback and the
# customer frontend's https://empm-test.mepstrait.in/callback at once. You must add the
# customer callback URL to this client in the Zitadel Console (see the docs file).
VITE_ZITADEL_CLIENT_ID=382760455313096708

# Grafana isn't tunneled in this setup — it stays local-only.
VITE_GRAFANA_URL=http://localhost:3000
