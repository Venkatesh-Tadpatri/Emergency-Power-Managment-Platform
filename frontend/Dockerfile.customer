FROM node:20-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE
ARG VITE_ZITADEL_AUTHORITY
ARG VITE_ZITADEL_CLIENT_ID
ENV VITE_API_BASE=$VITE_API_BASE \
    VITE_ZITADEL_AUTHORITY=$VITE_ZITADEL_AUTHORITY \
    VITE_ZITADEL_CLIENT_ID=$VITE_ZITADEL_CLIENT_ID

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.customer.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 5174

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:5174/healthz || exit 1

